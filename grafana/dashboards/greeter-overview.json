{
  "title": "aegis-greeter — overview",
  "uid": "aegis-greeter-overview",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["aegis-stateless", "managed-by-terraform"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"aegis-greeter\"}[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"aegis-greeter\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"aegis-greeter\"}[5m])), 1e-9)",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p95 / p99 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"aegis-greeter\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=\"aegis-greeter\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests + healthy pod count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "sum(http_server_active_requests{service_name=\"aegis-greeter\"})",
          "legendFormat": "in-flight"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "sum(kube_deployment_status_replicas_ready{deployment=\"aegis-greeter\"})",
          "legendFormat": "ready pods"
        }
      ]
    },
    {
      "id": 5,
      "title": "Personalized vs default greetings (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "$${prometheus_uid}" },
          "expr": "sum by (personalized) (rate(greeter_responses_total[5m]))",
          "legendFormat": "personalized={{personalized}}"
        }
      ]
    }
  ]
}
